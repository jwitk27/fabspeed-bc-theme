ed.com/sitemap/\">Sitemap</a></p>\r\n                    </div>\r\n                {{/if}}\r\n                {{#if theme_settings.show_powered_by}}\r\n                    <div class=\"footer-copyright\">\r\n                        <p class=\"powered-by\">{{theme_settings.powered_by_content}}</p>\r\n                    </div>\r\n                {{/if}}\r\n            </div>\r\n            <div class=\"item\">\r\n                {{> components/common/payment-icons}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</footer>\r\n{{#if theme_settings.themevale_BackTop}}\r\n    <div id=\"back-to-top\">\r\n        <a href=\"javascript:void(0)\"><svg class=\"icon\"><use xlink:href=\"#icon-keyboard-arrow-down\"></use></svg></a>\r\n    </div>\r\n{{/if}}\r\n\r\n\r\n\r\n{{#if theme_settings.themevale_RecentlyBought}}\r\n<div class=\"themevale_popup_left\"></div>\r\n{{/if}}\r\n\r\n{{#if settings.privacy_cookie }}\r\n    <div class=\"themevale_popup_right\">\r\n        {{> components/common/cookie }}\r\n    </div>\r\n{{/if}}","components/common/payment-icons":"{{#with theme_settings}}\n    {{#or show_accept_amex show_accept_discover show_accept_mastercard show_accept_paypal show_accept_visa show_accept_sage show_accept_wallet show_accept_sage}}\n        <div class=\"footer-payment-image\">\n            {{#if show_accept_visa}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-1.png\" alt=\"payment-1\">\n            {{/if}}\n            {{#if show_accept_mastercard}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-2.png\" alt=\"payment-2\">\n            {{/if}}\n            {{#if show_accept_amex}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-3.png\" alt=\"payment-3\">\n            {{/if}}\n            {{#if show_accept_discover}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-4.png\" alt=\"payment-4\">\n            {{/if}}\n            {{#if show_accept_paypal}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-5.png\" alt=\"payment-5\">\n            {{/if}}\n            {{#if show_accept_sage}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-6.png\" alt=\"payment-6\">\n            {{/if}}\n            {{#if show_accept_wallet}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"/product_images/uploaded_images/payment-7.png\" alt=\"payment-7\">\n            {{/if}}\n        </div>\n    {{/or}}\n{{/with}}\n","components/common/social-links":"{{#if social_media}}\n    <ul class=\"socialLinks socialLinks--alt\">\n        {{#each social_media}}\n            <li class=\"socialLinks-item\">\n                {{#if display_name '===' 'twitter'}}\n                    <a class=\"icon icon--google\" href=\"https://www.tiktok.com/@fabspeed?lang=en\" target=\"_blank\" rel=\"noopener\">\n                        <img src=\"https://store-fh9wsjv2.mybigcommerce.com/content/tik-tok.svg\"></img>\n                    </a>\n                {{else}}\n                    <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                        <svg><use xlink:href=\"#icon-{{display_name}}\" /></svg>\n                    </a>\n                {{/if}}\n            </li>\n        {{/each}}\n    </ul>\n{{/if}}\n","components/common/subscription-form":"<h5 class=\"footer-info-heading\">{{lang 'newsletter.subscribe'}}</h5>\n<p>{{lang 'newsletter.subscribe_intro'}}</p>\n<form class=\"form\" action=\"{{urls.subscribe.action}}\" method=\"post\">\n    <fieldset class=\"form-fieldset\">\n        <input type=\"hidden\" name=\"action\" value=\"subscribe\">\n        <input type=\"hidden\" name=\"nl_first_name\" value=\"bc\">\n        <input type=\"hidden\" name=\"check\" value=\"1\">\n        <div class=\"form-field\">\n            <label class=\"form-label is-srOnly\" for=\"nl_email\">{{lang 'common.email_address'}}</label>\n            <div class=\"form-prefixPostfix wrap\">\n                <input class=\"form-input\" id=\"nl_email\" name=\"nl_email\" type=\"email\" value=\"{{customer.email}}\" placeholder=\"{{lang 'newsletter.email_placeholder'}}\">\n                <input class=\"button button--primary form-prefixPostfix-button--postfix\" type=\"submit\" value=\"{{lang 'newsletter.subscribe_submit'}}\">\n            </div>\n            {{#if settings.show_newsletter_summary }}\n                <div class=\"footer-newsletter-summary\">{{settings.newsletter_summary}}</div>\n            {{/if}}\n        </div>\n    </fieldset>\n</form>\n"}
