{
  "components/cart/totals": "<div class=\"cart-totals\">\r\n    <div class=\"column column-1\">\r\n        {{#if cart.discount }}\r\n            <div class=\"cart-total\">\r\n                <div class=\"cart-total-label\">\r\n                    <strong>{{lang 'cart.discount'}}:</strong>\r\n                </div>\r\n                <div class=\"cart-total-value\">\r\n                    {{cart.discount.formatted}}\r\n                </div>\r\n            </div>\r\n        {{/if}}\r\n        {{#if cart.coupons}}\r\n            {{#each cart.coupons}}\r\n                <div class=\"cart-total\">\r\n                    <div class=\"cart-total-label\">\r\n                        <strong>{{lang 'cart.coupons.code_label' code=code}}</strong>\r\n                        <div>\r\n                            <a href=\"{{remove_url}}\">{{lang 'cart.coupons.remove'}}</a>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"cart-total-value\">\r\n                        <span>{{discount.formatted}}</span>\r\n                    </div>\r\n                </div>\r\n            {{/each}}\r\n        {{else}}\r\n            <div class=\"cart-total\">\r\n                <div class=\"cart-total-label\">\r\n                    <strong>{{lang 'cart.coupon_code'}}:</strong>\r\n                </div>\r\n                {{> components/cart/coupon-input}}\r\n            </div>\r\n        {{/if}}\r\n        {{#if settings.gift_certificates_enabled}}\r\n            {{#each cart.gift_certificates}}\r\n                <div class=\"cart-total\">\r\n                    <div class=\"cart-total-label\">\r\n                        <strong>{{lang 'cart.gift_certificates.code_label' code=code}}</strong>\r\n                        <span>\r\n                            {{remaining.formatted}} | <a href=\"{{remove_url}}\">{{lang 'cart.gift_certificates.remove'}}</a>\r\n                        </span>\r\n                    </div>\r\n                    <div class=\"cart-total-value\">\r\n                        {{used.formatted}}\r\n                    </div>\r\n                </div>\r\n            {{/each}}\r\n            <div class=\"cart-total\">\r\n                <div class=\"cart-total-label\">\r\n                    <strong>{{lang 'cart.gift_certificates.gift_certificate'}}:</strong>\r\n                </div>\r\n                {{> components/cart/gift-certificate-input}}\r\n            </div>\r\n        {{/if}}\r\n    </div>\r\n    <div class=\"column column-2\">\r\n        {{#if cart.shipping_handling.show_estimator}}\r\n            <div class=\"cart-total\">\r\n                <div class=\"cart-total-label\">\r\n                    <strong>{{lang 'cart.checkout.shipping'}}:</strong>\r\n                </div>\r\n                {{> components/cart/shipping-estimator cart.shipping_handling}}\r\n            </div>\r\n        {{/if}}\r\n    </div>\r\n    <div class=\"column column-3\">\r\n        <div class=\"cart-total\">\r\n            <div class=\"cart-total-label\">\r\n                <strong>{{lang 'cart.checkout.order_title'}}:</strong>\r\n            </div>\r\n        </div>\r\n        <div class=\"cart-total cart-total-custom\">\r\n            <div class=\"cart-total-label\">\r\n                <strong>{{lang 'cart.checkout.subtotal'}}:</strong>\r\n            </div>\r\n            <div class=\"cart-total-value\">\r\n                {{#or customer (if theme_settings.restrict_to_login '!==' true)}}\r\n                    <span>{{cart.sub_total.formatted}}</span>\r\n                {{else}}\r\n                    {{> components/common/login-for-pricing}}\r\n                {{/or}}\r\n            </div>\r\n        </div>\r\n        <div class=\"cart-total cart-total-custom\">\r\n        {{#each cart.taxes}}\r\n       \r\n            <div class=\"cart-total-label\">\r\n                <strong>{{name}}:</strong>\r\n            </div>\r\n            <div class=\"cart-total-value\">\r\n                <span>{{cost.formatted}}</span>\r\n            </div>\r\n            {{/each}}\r\n        </div>\r\n        {{#if cart.gift_wrapping_cost.amount}}\r\n            <div class=\"cart-total cart-total-custom\">\r\n                <div class=\"cart-total-label\">\r\n                    <strong>{{lang 'cart.checkout.gift_wrapping'}}:</strong>\r\n                </div>\r\n                <div class=\"cart-total-value\">\r\n                    <span>{{cart.gift_wrapping_cost.formatted}}</span>\r\n                </div>\r\n            </div>\r\n        {{/if}}\r\n        <div class=\"cart-total cart-total-custom cart-total-grandTotal\">\r\n            <div class=\"cart-total-label\">\r\n                <strong>{{lang 'cart.checkout.grand_total'}}:</strong>\r\n            </div>\r\n            <div class=\"cart-total-value cart-total-grandTotal\">\r\n                {{#or customer (if theme_settings.restrict_to_login '!==' true)}}\r\n                    <span>{{cart.grand_total.formatted}}</span>\r\n                {{else}}\r\n                    {{> components/common/login-for-pricing}}\r\n                {{/or}}\r\n            </div>\r\n        </div>\r\n        {{#if cart.show_primary_checkout_button}}\r\n            <div class=\"cart-actions checkout-button\">\r\n                <a class=\"button button--primary\" href=\"{{urls.checkout.single_address}}\" title=\"{{lang 'cart.checkout.title'}}\">{{lang 'cart.checkout.button'}}</a>\r\n                {{#if cart.show_multiple_address_shipping}}\r\n                    <a class=\"checkoutMultiple\" href=\"{{urls.checkout.multiple_address}}\">\r\n                        {{lang 'cart.preview.checkout_multiple'}}\r\n                    </a>\r\n                {{/if}}\r\n            </div>\r\n        {{else}}\r\n            <div class=\"cart-actions\">\r\n                <a class=\"button\" href=\"{{urls.home}}\" title=\"{{lang 'cart.continue_shopping'}}\">{{lang 'cart.continue_shopping'}}</a>\r\n            </div>\r\n        {{/if}}\r\n        <div class=\"themevale_securityContact\">\r\n            <div class=\"wrapper\">\r\n                <i class=\"icon\"><svg><use xlink:href=\"#icon-user-protection\"></use></svg></i>\r\n                <p class=\"text\">{{lang 'cart.checkout.contact_title'}}</p>\r\n            </div>\r\n            <p class=\"description\">{{lang 'cart.checkout.contact_content'}}</p>\r\n        </div>\r\n    </div>\r\n</div>\r\n",
  "components/cart/coupon-input": "<div class=\"cart-form coupon-code\">\n\t<p class=\"text\">{{lang 'cart.coupons.coupon_des'}}</p>\n    <form class=\"form form--hiddenLabels coupon-form\" method=\"post\" action=\"{{urls.cart}}\">\n        <label class=\"form-label\" for=\"couponcode\">{{lang 'cart.coupons.coupon_code'}}</label>\n        <input class=\"form-input\" data-error=\"{{lang 'cart.coupons.empty_error'}}\"  id=\"couponcode\" type=\"text\" name=\"couponcode\" value=\"\" placeholder=\"{{lang 'cart.coupons.coupon_code'}}\">\n        <input class=\"button button--small\" type=\"submit\" value=\"{{lang 'cart.coupons.button'}}\">\n        <input type=\"hidden\" name=\"action\" value=\"applycoupon\">\n    </form>\n</div>\n",
  "components/common/login-for-pricing": "<p translate>Log in for pricing</p>\n",
  "components/cart/gift-certificate-input": "<div class=\"cart-form gift-certificate-code\">\n\t<p class=\"text\">{{lang 'cart.gift_certificates.gift_des'}}</p>\n    <form class=\"form form--hiddenLabels cart-gift-certificate-form\" method=\"post\" action=\"{{urls.cart}}\">\n        <label class=\"form-label\" for=\"certcode\">{{lang 'cart.gift_certificates.cert_code'}}</label>\n        <input class=\"form-input\" data-error=\"{{lang 'cart.gift_certificates.empty_error'}}\"  id=\"certcode\" type=\"text\" name=\"certcode\" value=\"\" placeholder=\"{{lang 'cart.gift_certificates.add_cert_code'}}\">\n        <input class=\"button button--small\" type=\"submit\" value=\"{{lang 'cart.coupons.button'}}\">\n        <input type=\"hidden\" name=\"action\" value=\"applycoupon\">\n    </form>\n</div>\n",
  "components/cart/shipping-estimator": "<div class=\"shipping-estimator\">\n    <p class=\"text\">{{lang 'cart.shipping_estimator.shipping_des'}}</p>\n    <form class=\"form estimator-form\" data-shipping-estimator>\n        <dl>\n            <dt class=\"estimator-form-label\">\n                <label class=\"form-label\" for=\"shipping-country\">{{lang 'cart.shipping_estimator.select_a_country'}}</label>\n            </dt>\n\n            <dd class=\"estimator-form-input\">\n                <select class=\"form-select\" id=\"shipping-country\" name=\"shipping-country\" data-field-type=\"Country\">\n                    <option>{{lang 'cart.shipping_estimator.select_a_country'}}</option>\n                    {{#each countries}}\n                        <option value=\"{{id}}\" {{#if selected}}selected=\"selected\"{{/if}}>\n                            {{name}}\n                        </option>\n                    {{/each}}\n                </select>\n            </dd>\n\n            <dt class=\"estimator-form-label\">\n                <label class=\"form-label\" for=\"shipping-state\">{{lang 'cart.shipping_estimator.select_a_state'}}</label>\n            </dt>\n\n            <dd class=\"estimator-form-input\">\n                {{#if states.length}}\n                    <select class=\"form-select\" id=\"shipping-state\" name=\"shipping-state\" data-field-type=\"State\">\n                        <option>{{lang 'cart.shipping_estimator.select_a_state'}}</option>\n                        {{#each states}}\n                            <option value=\"{{id}}\" {{#if selected}}selected=\"selected\"{{/if}}>\n                                {{name}}\n                            </option>\n                        {{/each}}\n                    </select>\n                {{else}}\n                    <input class=\"form-input\" type=\"text\" id=\"shipping-state\" name=\"shipping-state\" data-field-type=\"State\" placeholder=\"{{lang 'cart.shipping_estimator.select_a_state'}}\">\n                {{/if}}\n            </dd>\n\n            <dt class=\"estimator-form-label\">\n                <label class=\"form-label\" for=\"shipping-city\">{{lang 'cart.shipping_estimator.suburb_city'}}</label>\n            </dt>\n            <dd class=\"estimator-form-input\">\n                <input class=\"form-input\" type=\"text\" id=\"shipping-city\" name=\"shipping-city\" value=\"{{selected_city}}\" placeholder=\"{{lang 'cart.shipping_estimator.suburb_city'}}\">\n            </dd>\n\n            <dt class=\"estimator-form-label\">\n                <label class=\"form-label\" for=\"shipping-zip\">{{lang 'cart.shipping_estimator.zip_postal_code'}}</label>\n            </dt>\n            <dd class=\"estimator-form-input\">\n                <input class=\"form-input\" type=\"text\" id=\"shipping-zip\" name=\"shipping-zip\" value=\"{{selected_zip}}\" placeholder=\"{{lang 'cart.shipping_estimator.zip_postal_code'}}\">\n            </dd>\n            <button class=\"button button--small shipping-estimate-submit\">{{lang 'cart.shipping_estimator.estimate_shipping'}}</button>\n        </dl>\n    </form>\n    <div class=\"shipping-quotes\"></div>\n</div>\n"
}
