{
  "components/themevale/header/header-layout-1": "<header class=\"header themevale_header-layout-1 header-sticky\">\r\n    <div class=\"themevale_header-PC\">\r\n        <div class=\"themevale_header-top\">\r\n            {{> components/common/navigation}}\r\n        </div>\r\n        <div class=\"themevale_header-middle {{#if customer.customer_group_name '===' 'Wholesale 15%'}}has-gray-bg\r\n        {{else if customer.customer_group_name '===' 'Wholesale 20%'}}has-gray-bg\r\n        {{else if customer.customer_group_name '===' 'Wholesale 25%'}}has-gray-bg\r\n        {{else if customer.customer_group_name '===' 'Wholesale 30%'}}has-gray-bg\r\n        {{/if}}\">\r\n            \r\n            <div class=\"container\" style=\"width: 100%;\">\r\n                <div class=\"headerMiddle-item text-left\">\r\n                    <div class=\"item--hamburger\">\r\n                        <a class=\"mobileMenu-toggle\" href=\"#\" data-mobile-menu-toggle=\"menu\">\r\n                            <span class=\"mobileMenu-toggleIcon\">Toggle menu</span>\r\n                        </a>\r\n                    </div>\r\n                    \r\n                    <div class=\"logo-wrapper\">\r\n                        {{#if customer.customer_group_id '===' 21}}\r\n                            <h1 class=\"header-logo\">\r\n                                <a href=\"/\">\r\n                                <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                                </a>\r\n                            </h1>\r\n                        {{else if customer.customer_group_id '===' 22}}\r\n                            <h1 class=\"header-logo\">\r\n                                <a href=\"/\">\r\n                                <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                                </a>\r\n                            </h1>\r\n                        {{else if customer.customer_group_id '===' 23}}\r\n                            <h1 class=\"header-logo\">\r\n                                <a href=\"/\">\r\n                                <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                                </a>\r\n                            </h1>\r\n                        {{else if customer.customer_group_id '===' 24}}\r\n                            <h1 class=\"header-logo\">\r\n                                <a href=\"/\">\r\n                                <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                                </a>\r\n                            </h1>\r\n                        {{else}}\r\n                            {{#if page_type '===' 'default'}}\r\n                                <h1 class=\"header-logo\">\r\n                                    {{> components/common/store-logo}}\r\n                                </h1>\r\n                            {{else}}\r\n                                <div class=\"header-logo\">\r\n                                    {{> components/common/store-logo}}\r\n                                </div>\r\n                            {{/if}}\r\n                        {{/if}}\r\n                    </div>\r\n                </div>\r\n                <div class=\"headerMiddle-item\">\r\n                    <div class=\"item item--office\">\r\n                        <a class=\"office-phone\" href=\"tell:{{theme_settings.themevale_office-phone}}\">{{theme_settings.themevale_office-phone}}</a>\r\n                        <p class=\"office-hours\">{{theme_settings.themevale_office-hours}}</p>\r\n                    </div>\r\n                    <div class=\"item item--quickSearch\">\r\n                        <div class=\"themevale_search-custom\" id=\"quickSearch2\" aria-hidden=\"true\" tabindex=\"-1\" data-prevent-quick-search-close>\r\n                            {{> components/themevale/header/quick-search-all}}\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item item--account\">\r\n                        {{#if customer}}\r\n                            <a class=\"navUser-action navUser-action--myaccount\" href=\"{{urls.account.index}}\">\r\n                                <strong>{{lang 'login.new_customer.myaccount'}}</strong>\r\n                                <i class=\"icon\" aria-hidden=\"true\"><svg><use xlink:href=\"#icon-chevron-down\" /></svg></i>\r\n                            </a>\r\n                            <ul class=\"dropdown-menu\" id=\"navPages-account-topbar\">\r\n                                <li class=\"dropdown-menu-item\">\r\n                                    <a href=\"{{urls.account.orders.all}}\">{{lang 'account.nav.orders'}}</a>\r\n                                </li>\r\n                                {{#if settings.returns_enabled}}\r\n                                    <li class=\"dropdown-menu-item\">\r\n                                        <a href=\"{{urls.account.returns}}\">{{lang 'account.nav.returns'}}</a>\r\n                                    </li>\r\n                                {{/if}}\r\n                                <li class=\"dropdown-menu-item\">\r\n                                    <a href=\"{{urls.account.inbox}}\">{{lang 'account.mobile_nav.messages'}}</a>\r\n                                </li>\r\n                                <li class=\"dropdown-menu-item\">\r\n                                    <a href=\"{{urls.account.addresses}}\">{{lang 'account.nav.addresses'}}</a>\r\n                                </li>\r\n                                {{#if settings.show_payment_methods}}\r\n                                    <li class=\"dropdown-menu-item\">\r\n                                        <a href=\"{{urls.account.payment_methods.all}}\">{{lang 'account.nav.payment_methods'}}</a>\r\n                                    </li>\r\n                                {{/if}}\r\n                                <li class=\"dropdown-menu-item\">\r\n                                    <a href=\"{{urls.account.wishlists.all}}\">{{lang 'account.mobile_nav.wishlists'}}</a>\r\n                                </li>\r\n                                <li class=\"dropdown-menu-item\">\r\n                                    <a href=\"{{urls.account.recent_items}}\">{{lang 'account.nav.recently_viewed'}}</a>\r\n                                </li>\r\n                                <li class=\"dropdown-menu-item\">\r\n                                    <a href=\"{{urls.account.details}}\">{{lang 'account.nav.settings'}}</a>\r\n                                </li>\r\n                            </ul>\r\n                        {{else}}\r\n                            <a class=\"navUser-action navUser-action--account\" href=\"{{urls.auth.login}}\">\r\n                                <strong>{{lang 'login.new_customer.myaccount'}}</strong>\r\n                                <i class=\"icon\" aria-hidden=\"true\"><svg><use xlink:href=\"#icon-chevron-down\" /></svg></i>\r\n                            </a>\r\n                        {{/if}}\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <div class=\"item-wislish\">\r\n                            <a class=\"navUser-action\" href=\"https://www.fabspeed.com/authorized-dealers-installers/\">\r\n                                <svg class=\"icon\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" vers