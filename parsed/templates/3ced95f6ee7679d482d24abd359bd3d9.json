  "components/common/navigation": "{{#if theme_settings.themevale_header-layout-1}}\r\n<div class=\"container navUser\">\r\n    <ul class=\"navUser-left navUser-section\"> \r\n        {{#if currency_selector.currencies.length '>' 1}}\r\n            <li class=\"navUser-item\">\r\n                {{> components/common/currency-selector}}\r\n            </li>\r\n        {{/if}}\r\n        <li class=\"navUser-item\">\r\n            <a href=\"https://www.fabspeed.com/lead-time-products/\">\r\n            <span class=\"navUser-text\" id=\"leadtime\" style=\"font-weight: bold; font-size: 1.4em;\">{{theme_settings.themevale_header-top-content}}</span>\r\n            <br>\r\n            <span class=\"navUser-text\" id=\"leadtime\" style=\"font-weight: bold; font-size: 11px;\">100% GUARANTEED WORLDS FINEST SPORTS CAR SOUND, PERFORMANCE SYSTEMS, AND COMPONENTS</span>\r\n            </a>\r\n        </li>\r\n    </ul>\r\n    <ul class=\"navUser-right navUser-section\">\r\n        <li class=\"navUser-item\">\r\n            <a class=\"navUser-action\" href=\"/track-order/\">Track Your Order</a>\r\n        </li>\r\n        \r\n        {{#if settings.gift_certificates_enabled}}\r\n            <li class=\"navUser-item\">\r\n                <a class=\"navUser-action\" href=\"{{urls.gift_certificate.purchase}}\">{{lang 'common.gift_cert'}}</a>\r\n            </li>\r\n        {{/if}}\r\n        \r\n        <li class=\"navUser-item\">\r\n            <a class=\"navUser-action\" href=\"/installation-guides/\">Install Guides</a>\r\n        </li>\r\n        <li class=\"navUser-item navUser-item--account\">\r\n            <i class=\"icon\" aria-hidden=\"true\"><svg><use xlink:href=\"#icon-user\" /></svg></i>\r\n            {{#if customer}}\r\n                <a class=\"navUser-action\" href=\"{{urls.account.index}}\"><strong>{{customer.name}}.</strong></a>\r\n                <a class=\"navUser-action\" href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\r\n            {{else}}\r\n                <a class=\"navUser-action\" href=\"javascript:void(0)\" style=\"color: red; font-weight: bold;\" data-login-form>{{lang 'common.login'}}</a>\r\n                {{#if settings.account_creation_enabled}}\r\n                <span class=\"navUser-or\">{{lang 'common.or'}}</span>\r\n                <a class=\"navUser-action\" href=\"{{urls.auth.create_account}}\">{{lang 'common.create_account'}}</a>\r\n                {{/if}}\r\n                {{#if page_type '!==' 'login'}}\r\n                    {{> components/themevale/header/login-form}}\r\n                {{/if}}\r\n            {{/if}}\r\n        </li>\r\n    </ul>\r\n</div>\r\n{{/if}}\r\n",
  "components/themevale/header/quick-search-all": "{{{ snippet \"forms_search\"}}}\r\n<form class=\"form\" action=\"{{urls.search}}\">\r\n    <fieldset class=\"form-fieldset\">\r\n        <div class=\"form-field\">\r\n            <div id=\"search_category\">\r\n                <select name=\"category\" class=\"select_category\">\r\n                    <option value=\"\" selected=\"\">All</option>\r\n                    {{#each categories}}\r\n                        <option value=\"{{id}}\">{{name}}</option>\r\n                        {{#if children}}\r\n                            {{#each children}}\r\n                                <option value=\"{{id}}\">--- {{name}}</option>\r\n                            {{/each}}\r\n                        {{/if}}\r\n                    {{/each}}\r\n                </select> \r\n                <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n            </div>\r\n            <input class=\"form-input\" data-search-quick name=\"search_query\" id=\"search_query\" data-error-message=\"{{lang 'search.error.empty_field'}}\" placeholder=\"{{lang 'search.quick_search.input_quickSearch'}}\" autocomplete=\"off\">\r\n            <button class=\"btn-search\" type=\"submit\"><svg class=\"icon\"><use xlink:href=\"#icon-search\"></use></svg></button>\r\n        </div>\r\n    </fieldset>\r\n</form>\r\n<div class=\"quickSearchResults\" data-bind=\"html: results\"></div>\r\n",
  "components/common/navigation-menu": "<div class=\"navPages-container\" id=\"menu\" data-menu>\r\n    <nav class=\"navPages\">\r\n        <ul class=\"navPages-list\">\r\n            {{#each categories}}\r\n                {{#or (if id '==' ../theme_settings.themevale_category-custom-1) (if id '==' ../theme_settings.themevale_category-custom-2) (if id '==' ../theme_settings.themevale_category-custom-3) (if id '==' ../theme_settings.themevale_category-custom-4) (if id '==' ../theme_settings.themevale_category-custom-5) (if id '==' ../theme_settings.themevale_category-custom-6)}}\r\n                {{else}}\r\n                    <li class=\"navPages-item\">\r\n                        {{> components/common/navigation-list-alternate}}\r\n                    </li>\r\n                {{/or}}\r\n            {{/each}}\r\n            {{#unless theme_settings.hide_content_navigation}}\r\n                {{#each pages}}\r\n                    <li class=\"navPages-item\">\r\n                        <a class=\"navPages-action\" href=\"https://www.fabspeed.com/hjs\"><span class=\"text\">{{name}}</span></a>\r\n                        <div class=\"navPage-subMenu navPage-subMenu-horizontal\" aria-hidden=\"false\" tabindex=\"-1\">\r\n                            <ul class=\"navPage-subMenu-list\">\r\n                                <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                                    <a class=\"navPage-subMenu-action navPages-action\" href=\"/hjs\"><span class=\"text\">HJS Explained</span></a>\r\n                                </li>\r\n                                <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                                    <a class=\"navPage-subMenu-action navPages-action\" href=\"/additional-products/hjs-catalytic-converters/\"><span class=\"text\">Shop HJS Cats</span></a>\r\n                                </li>\r\n                                <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                                    <a class=\"navPage-subMenu-action navPages-action\" href=\"/clean-green\"><span class=\"text\">Clean & Green</span></a>\r\n                                </li>\r\n                                <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                                    <a class=\"navPage-subMenu-action navPages-action\" href=\"/catalyst-re-coring\"><span class=\"text\">Catalyst Re-Coring</span></a>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </li>\r\n                {{/each}}\r\n            {{/unless}}\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action\" href=\"/dealers/\"><span class=\"text\">Dealers</span></a>\r\n                <div class=\"navPage-subMenu navPage-subMenu-horizontal\" aria-hidden=\"false\" tabindex=\"-1\">\r\n                    <ul class=\"navPage-subMenu-list\">\r\n                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/authorized-dealers-installers/\"><span class=\"text\">Find a Dealer</span></a>\r\n                        </li>\r\n                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/become-a-dealer/\"><span class=\"text\">Dealer Application</span></a>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </li>\r\n            \r\n        </ul>\r\n        <ul class=\"navPages-list navPages-list--user\">\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action\" href=\"{{urls.account.wishlists.all}}\">\r\n                    <span class=\"text\"><svg class=\"icon\"><use xlink:href=\"#icon-heart\"/></svg><span>{{lang 'account.mobile_nav.wishlists'}}</span></span>\r\n                </a>\r\n            </li>\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action\" href=\"/contact-us/\">\r\n                    <span class=\"text\"><svg class=\"icon\"><use xlink:href=\"#icon-location\"/></svg><span>Store Locator</span></span>\r\n                </a>\r\n            </li>\r\n            <li class=\"navPages-item\">\r\n                <a class=\"navPages-action\" href=\"tel:{{settings.phone_number}}\">\r\n                    <span class=\"text\"><svg class=\"icon\"><use xlink:href=\"#icon-telephone\"/></svg><span>Contact us: {{settings.phone_number}}</span></span>\r\n                </a>\r\n            </li>\r\n            <!--\r\n            {{#if settings.gift_certificates_enabled}}\r\n                <li class=\"navPages-item\">\r\n                    <a class=\"navPages-action\" href=\"{{urls.gift_certificate.purchase}}\">\r\n                        <span class=\"text\"><svg class=\"icon\"><use xlink:href=\"#icon-gift\"/></svg><span>{{lang 'common.gift_cert'}}</span></span>\r\n                    </a>\r\n                </li>\r\n            {{/if}}\r\n            -->\r\n            {{#if currency_selector.currencies.length '>' 1}}\r\n                <li class=\"navPages-item\">\r\n                    <p class=\"navPages-action has-subMenu\">\r\n                        <a class=\"text\" href=\"javascript:void(0)\">{{{currency_selector.active_currency_flag}}} {{lang 'common.currency' code=currency_selector.active_currency_code}}</a>\r\n                        <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                            <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n                        </span>\r\n                    </p>\r\n                    <div class=\"navPage-subMenu\" id=\"navPages-currency\" aria-hidden=\"true\" tabindex=\"-1\">\r\n                        <ul class=\"navPage-subMenu-list\">\r\n                            <li class=\"navPage-subMenu-item-child navPage-subMenu-title\">\r\n                                <p class=\"navPage-subMenu-action navPages-action\">\r\n                                    <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                                        <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n                                        <span>back</span>\r\n                                    </span>\r\n                                    <a class=\"text\" href=\"javascript:void(0)\">{{{currency_selector.active_currency_flag}}} {{lang 'common.currency' code=currency_selector.active_currency_code}}</a>\r\n                                </p>\r\n                            </li>\r\n                            {{#each currency_selector.currencies}}\r\n                            <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                                <a class=\"navPage-subMenu-action navPages-action\" href=\"{{{switch_url}}}\">\r\n                                    <span class=\"text\">\r\n                                    {{#if is_active}}\r\n                                        {{{flag}}} {{name}}\r\n                                    {{else}}\r\n                                        {{{flag}}} {{name}}\r\n                                    {{/if}}\r\n                                    </span>\r\n                                </a>\r\n                            </li>\r\n                            {{/each}}\r\n                        </ul>\r\n                    </div>\r\n                </li>\r\n            {{/if}}\r\n            <li class=\"navPages-item\">\r\n                {{> components/common/social-links}}\r\n            </li>\r\n        </ul>\r\n    </nav>\r\n</div>\r\n\r\n",
  "components/themevale/header/header-mobile": "<div class=\"header-Mobile-item text-left\">\r\n    <div class=\"items item--hamburger\">\r\n    </div>\r\n    <div class=\"items item--searchMobile\">\r\n        <a class=\"navUser-action\" href=\"#\" data-search=\"quickSearch\" aria-controls=\"quickSearch\" aria-expanded=\"false\">\r\n            <div class=\"navUser-icon\">\r\n                <svg class=\"icon\"><use xlink:href=\"#icon-search2\"></use></svg>\r\n                <svg class=\"icon icon-close\"><use xlink:href=\"#times\"></use></svg>\r\n            </div>\r\n        </a>\r\n    </div>\r\n</div>\r\n<div class=\"header-Mobile-item text-center\">\r\n    <div class=\"items\">\r\n        <div class=\"logo-wrapper\">\r\n            {{#if customer.customer_group_id '===' 21}}\r\n                <h1 class=\"header-logo\">\r\n                    <a href=\"https://www.fabspeed.com\">\r\n                    <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                    </a>\r\n                </h1>\r\n            {{else if customer.customer_group_id '===' 22}}\r\n                <h1 class=\"header-logo\">\r\n                    <a href=\"https://www.fabspeed.com\">\r\n                    <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                    </a>\r\n                </h1>\r\n            {{else if customer.customer_group_id '===' 23}}\r\n                <h1 class=\"header-logo\">\r\n                    <a href=\"https://www.fabspeed.com\">\r\n                    <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                    </a>\r\n                </h1>\r\n            {{else if customer.customer_group_id '===' 24}}\r\n                <h1 class=\"header-logo\">\r\n                    <a href=\"https://www.fabspeed.com\">\r\n                    <img class=\"header-logo\" src=\"https://cdn11.bigcommerce.com/s-fh9wsjv2/images/stencil/original/image-manager/dealer-logo-test-5.png?t=1737401960\" alt=\"Custom Header Image\">\r\n                    </a>\r\n                </h1>\r\n            {{else}}\r\n            {{#if page_type '===' 'default'}}\r\n                <h1 class=\"header-logo\">\r\n                    {{> components/common/store-logo}}\r\n                </h1>\r\n            {{else}}\r\n                <div class=\"header-logo\">\r\n                    {{> components/common/store-logo}}\r\n                </div>\r\n            {{/if}}\r\n            {{/if}}\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"header-Mobile-item text-right\">\r\n    <div class=\"items item--account\">\r\n        <a class=\"navUser-action {{#if page_type '!==' 'login'}}accountMobile{{/if}}\" href=\"javascript:void(0)\">\r\n            <div class=\"navUser-icon\">\r\n                <svg class=\"icon\"><use xlink:href=\"#icon-user\"/></svg>\r\n            </div>\r\n        </a>\r\n    </div>\r\n    <div class=\"items item--cart themevale_cart\">\r\n        <a class=\"navUser-action cartMobile\"\r\n            data-cart-preview\r\n            href=\"{{urls.cart}}\">\r\n            <div class=\"navUser-icon navUser-item-cartIcon\">\r\n                <svg class=\"icon\"><use xlink:href=\"#icon-cart\"></use></svg>\r\n                <span class=\"countPill{{#if cart.items}} countPill--positive{{/if}} cart-quantity\">{{#if cart.items}}{{cart.quantity}}{{else}}0{{/if}}</span>\r\n            </div>\r\n        </a>\r\n    </div>\r\n</div>\r\n",
  "components/common/store-logo": "<a href=\"{{urls.home}}\">\n    {{#if settings.store_logo.image}}\n        {{#if theme_settings.logo_size '===' 'original'}}\n            <img class=\"header-logo-image-unknown-size\" src=\"{{getImage settings.store_logo.image 'logo_size'}}\" alt=\"{{settings.store_logo.title}}\" title=\"{{settings.store_logo.title}}\">\n        {{else}}\n            <span class=\"header-logo-image-container\">\n                <img class=\"header-logo-image\" src=\"{{getImage settings.store_logo.image 'logo_size'}}\" alt=\"{{settings.store_logo.title}}\" title=\"{{settings.store_logo.title}}\">\n            </span>\n        {{/if}}\n    {{else}}\n        <span class=\"header-logo-text\">{{settings.store_logo.title}}</span>\n    {{/if}}\n</a>\n",
  "components/common/currency-selector": "<a class=\"navUser-action navUser-action--currencySelector\" href=\"javascript:void(0)\">\n    <span class=\"image-flag\">{{{currency_selector.active_currency_flag}}}</span> \n    <span class=\"text-flag\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n    <i class=\"icon\" aria-hidden=\"true\"><svg><use xlink:href=\"#icon-chevron-down\" /></svg></i></a>\n<ul class=\"dropdown-menu\" id=\"currencySelection\">\n    {{#each currency_selector.currencies}}\n    <li class=\"dropdown-menu-item\">\n        <a href=\"{{{switch_url}}}\">\n            {{#if is_active}}\n                {{{flag}}} <strong>{{name}}</strong>\n            {{else}}\n                {{{flag}}} {{name}}\n            {{/if}}\n        </a>\n    </li>\n    {{/each}}\n</ul>\n",
  "components/common/navigation-list-alternate": "{{#if children}}\r\n    <p class=\"navPages-action navPages-action-depth-max has-subMenu is-root\">\r\n            <a class=\"text\" href=\"javascript:void(0)\">{{name}}</a>\r\n        <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\r\n            <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n        </span>\r\n    </p>\r\n    {{> components/common/navigation-dropdown}}\r\n{{else}}\r\n    <a class=\"navPages-action\" href=\"{{url}}\"><span class=\"text\">{{name}}</span></a>\r\n{{/if}}\r\n",
  "components/themevale/header/login-form": "<div class=\"login-dropdown\" id=\"login-dropdown\">\r\n    <div class=\"login-header\">\r\n        <h2 class=\"login-title\">{{lang 'login.new_customer.heading2' }}</h2>\r\n        <a href=\"#\" class=\"close\" data-close-login-dropdown><span aria-hidden=\"true\">&#215;</span></a>\r\n    </div>\r\n    <div class=\"login-content\">\r\n        <form class=\"login-form form\" action=\"{{settings.secure_base_url}}/login.php?action=check_login\" method=\"post\">\r\n            {{inject 'useValidEmail' (lang 'forms.validate.common.email_address')}}\r\n            {{inject 'enterPass' (lang 'forms.validate.common.password')}}\r\n            <p class=\"intro\">{{lang 'login.intro'}}</p>\r\n            <div class=\"form-field\">\r\n                <label class=\"form-label\" for=\"login_email2\">{{lang 'login.field_email'}}</label>\r\n                <input class=\"form-input\" name=\"login_email\" id=\"login_email2\" type=\"email\">\r\n            </div>\r\n            <div class=\"form-field\">\r\n                <label class=\"form-label\" for=\"login_pass2\">{{lang 'login.field_password'}}</label>\r\n                <input class=\"form-input\" id=\"login_pass2\" type=\"password\" name=\"login_pass\">\r\n            </div>\r\n            <div class=\"form-actions\">\r\n                <a class=\"forgot-password\" href=\"{{urls.auth.forgot_password}}\">{{lang 'login.forgot_password' }}</a>\r\n                <input type=\"submit\" class=\"button button--border\" value=\"{{lang 'login.button' }}\">\r\n            </div>\r\n        </form>\r\n    </div>\r\n    {{#if settings.account_creation_enabled}}\r\n        <div class=\"login-footer\">\r\n            <p class=\"intro\">{{lang 'create_account.intro' }}</p>\r\n            <a class=\"button button--secondary\" href=\"{{urls.auth.create_account}}\">{{lang 'create_account.button' }}</a>\r\n        </div>\r\n    {{/if}}\r\n</div>\r\n",
  "components/common/social-links": "{{#if social_media}}\n    <ul class=\"socialLinks socialLinks--alt\">\n        {{#each social_media}}\n            <li class=\"socialLinks-item\">\n                {{#if display_name '===' 'twitter'}}\n                    <a class=\"icon icon--google\" href=\"https://www.tiktok.com/@fabspeed?lang=en\" target=\"_blank\" rel=\"noopener\">\n                        <img src=\"https://store-fh9wsjv2.mybigcommerce.com/content/tik-tok.svg\"></img>\n                    </a>\n                {{else}}\n                    <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                        <svg><use xlink:href=\"#icon-{{display_name}}\" /></svg>\n                    </a>\n                {{/if}}\n            </li>\n        {{/each}}\n    </ul>\n{{/if}}\n",
  "components/common/navigation-dropdown": "<div class=\"navPage-subMenu navPage-subMenu-horizontal\" aria-hidden=\"true\" tabindex=\"-1\">\r\n    <ul class=\"navPage-subMenu-list\">\r\n        <li class=\"navPage-subMenu-item-child navPage-subMenu-title\">\r\n            <p class=\"navPage-subMenu-action navPages-action\">\r\n                <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                    <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n                </span>\r\n                <a class=\"text\" href=\"{{url}}\">{{name}}</a>\r\n            </p>\r\n        </li>\r\n        {{#if name '==' 'About Us'}}\r\n        <li class=\"navPage-submenu-item-child navPages-action-end\">\r\n            <a class=\"navPage-subMenu-action navPages-action\" href=\"/who-we-are/\"><span class=\"text\">Who We Are</span></a>\r\n        </li>\r\n        {{/if}}\r\n        {{#each children}}\r\n            {{#if children}}\r\n                <li class=\"navPage-subMenu-item-child\">\r\n                    <p class=\"navPage-subMenu-action navPages-action navPages-action-depth-max has-subMenu\">\r\n                        <a class=\"text\" href=\"{{url}}\">{{name}}</a>\r\n                        <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\r\n                            <svg class=\"icon\"><use xlink:href=\"#icon-chevron-down\" /></svg>\r\n                        </span>\r\n                    </p>\r\n                    {{> components/common/navigation-dropdown}}\r\n                </li>\r\n            {{else}}\r\n                <li class=\"navPage-subMenu-item-child navPages-action-end\">\r\n                    <a class=\"navPage-subMenu-action navPages-action\" href=\"{{url}}\"><span class=\"text\">{{name}}</span></a>\r\n                </li>\r\n            {{/if}}\r\n        {{/each}}\r\n    </ul>\r\n</div>\r\n"
}
