{
  "components/account/orders-list": "<h3 class=\"account-heading\">{{lang 'account.orders.heading' }}</h3>\r\n\r\n<ul class=\"account-list\">\r\n    {{#each orders}}\r\n    <li class=\"account-listItem\">\r\n        <div class=\"account-product\">\r\n            <div class=\"account-product-figure\">\r\n                {{#if items.0.type '===' 'giftcertificate'}}\r\n                    <img class=\"lazyload\" data-sizes=\"auto\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"{{cdn ../../theme_settings.default_image_gift_certificate}}\" alt=\"GiftCertificate\" title=\"GiftCertificate\">\r\n                {{else}}\r\n                    <img class=\"account-product-image lazyload\"\r\n                         data-sizes=\"auto\"\r\n                         src=\"{{cdn 'img/loading.svg'}}\"\r\n                         data-src=\"{{getImage image 'productthumb_size' (cdn ../../theme_settings.default_image_product)}}\"\r\n                         alt=\"{{image.alt}}\"\r\n                         title=\"{{image.alt}}\">\r\n                {{/if}}\r\n            </div>\r\n            <div class=\"account-product-body\">\r\n                <div class=\"account-orderStatus\">\r\n                    <h6 class=\"account-orderStatus-label\">{{this.status}}</h6>\r\n                    {{#if ../settings.returns_enabled}}\r\n                        {{#if this.return_url}}\r\n                            <a class=\"account-orderStatus-action\" href=\"{{this.return_url}}\">\r\n                                {{lang 'account.orders.return_items' }}\r\n                            </a>\r\n                        {{/if}}\r\n                    {{/if}}\r\n                </div>\r\n\r\n                <h5 class=\"account-product-title\">\r\n                    <a href=\"{{this.details_url}}\">{{lang 'account.orders.list.order_number' number=this.id}}</a>\r\n                </h5>\r\n                <p class=\"account-product-description\">{{lang 'account.orders.list.product_details' num_products=this.items.length cost=this.total.formatted}}</p>\r\n\r\n                <div class=\"account-product-details\">\r\n                    <div class=\"account-product-detail\">\r\n                        <h6 class=\"account-product-detail-heading\">{{lang 'account.orders.order_placed' }}</h6>\r\n                        <span>{{this.date}}</span>\r\n                    </div>\r\n                    <div class=\"account-product-detail\">\r\n                        <h6 class=\"account-product-detail-heading\">{{lang 'account.orders.last_update' }}</h6>\r\n                        <span>{{this.last_update_date}}</span>\r\n                    </div>\r\n                    \r\n                    <div class=\"account-product-detail\">\r\n                        <h6 class=\"account-product-detail-heading\">PO# (your records)</h6>\r\n                        <span id=\"po-{{this.id}}\">Loading...</span>\r\n                    </div>\r\n                    <script>\r\n                        (async function() {\r\n                            try {\r\n                                const orderId = '{{this.id}}';\r\n                                const response = await fetch(`/api/storefront/orders/${orderId}`);\r\n                                const orderData = await response.json();\r\n                                const installLocation = orderData.billingAddress.customFields[4]?.fieldValue || 'N/A';\r\n                                const spanElement = document.getElementById(`po-${orderId}`);\r\n                                if (spanElement) {\r\n                                    spanElement.textContent = installLocation;\r\n                                }\r\n                            } catch (error) {\r\n                                console.error(`Error fetching order details:`, error);\r\n                            }\r\n                        })();\r\n                    </script>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </li>\r\n    {{/each}}\r\n</ul>\r\n"
}
